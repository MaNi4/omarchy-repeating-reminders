#!/bin/bash

# Reminders that can repeat. Works like omarchy-reminder (a transient systemd
# user timer that sends a notification), with one addition: --loop keeps the
# timer firing every <minutes> until it is stopped. Minutes may be a fraction
# (0.5 or 0,5), or the time can be given in seconds (30s). A reminder keeps
# to "Silence notifications": it is then held back like any other
# notification and can be read in the history afterwards. --loud makes one
# that shows regardless.
#
# Each reminder has a small JSON file in the state directory, holding the
# clock time it is next due. Every firing is its own one-shot timer set to
# that time, not to "so long from now": a countdown starts over whenever the
# user manager is re-executed (every package install does that) and stands
# still while the machine sleeps, a clock time does neither. A one-off
# reminder removes its file when it fires. A looping one moves the time on
# and sets the next timer, and `list` sets it again after a reboot or logout.

set -euo pipefail

glyph=$'\U000f009e' # nf-md-bell-ring
prefix="repeating-reminder"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/repeating-reminders"
self=$(readlink -f "${BASH_SOURCE[0]}")

usage() {
  echo "Usage: repeating-reminder add [--loop] [--loud] <minutes|seconds>s [message]"
  echo "       repeating-reminder list"
  echo "       repeating-reminder stop <unit>"
  echo "       repeating-reminder clear"
}

notify() {
  omarchy-notification-send -g "$glyph" "$@" >/dev/null 2>&1 || true
}

valid_unit() {
  [[ $1 =~ ^$prefix-[0-9]+-[0-9]+$ ]]
}

# The timer of one firing is named after the reminder and the time it is due.
timer_active() {
  systemctl --user --quiet is-active "$1-$2.timer" 2>/dev/null
}

save() {
  local file="$state_dir/$1.json" at=$2

  jq -c --argjson at "$at" '. + {at:$at}' "$file" >"$file.tmp" && mv -f "$file.tmp" "$file"
}

# The first time after `from` that a reminder due at `at` every `seconds`
# comes round again.
next_after() {
  local at=$1 seconds=$2 from=$3

  ((at <= from)) && at=$((at + ((from - at) / seconds + 1) * seconds))
  echo "$at"
}

# "0.5", "0,5" or "30s" as whole seconds; nothing when it is not a time, is
# shorter than five seconds or longer than 99999 minutes.
to_seconds() {
  local value=${1//,/.} seconds=""

  if [[ $value =~ ^[0-9]{1,7}s$ ]]; then
    seconds=$((10#${value%s}))
  elif [[ $value =~ ^[0-9]{0,5}(\.[0-9]{1,3})?$ && $value == *[0-9]* ]]; then
    seconds=$(LC_ALL=C awk -v m="$value" 'BEGIN { printf "%d", m * 60 + 0.5 }')
  fi

  [[ -n $seconds ]] && ((seconds >= 5 && seconds <= 5999940)) && echo "$seconds"
  return 0
}

# 30 -> "30 seconds", 300 -> "5 minutes", 90 -> "1 min 30 s"
spoken() {
  local seconds=$1

  if ((seconds < 60)); then
    echo "$seconds seconds"
  elif ((seconds % 60 == 0)); then
    ((seconds == 60)) && echo "1 minute" || echo "$((seconds / 60)) minutes"
  else
    echo "$((seconds / 60)) min $((seconds % 60)) s"
  fi
}

start_timer() {
  local unit=$1 at=$2

  systemd-run --user --quiet --collect --unit="$unit-$at" \
    --on-calendar="$(date -u -d "@$at" '+%Y-%m-%d %H:%M:%S UTC')" --timer-property=AccuracySec=1s \
    "$self" fire "$unit" "$at"
}

# Run by the timer.
fire() {
  local unit=$1 at=${2:-} file="$state_dir/$1.json"
  local message loop quiet seconds due

  [[ -f $file ]] || exit 0
  message=$(jq -r '.label' "$file")
  loop=$(jq -r '.loop' "$file")
  quiet=$(jq -r '.quiet // false' "$file")
  seconds=$(jq -r '.seconds' "$file")
  due=$(jq -r '.at // empty' "$file")

  # A timer left over from before the reminder was moved on.
  [[ -z $at || -z $due || $at == "$due" ]] || exit 0

  if [[ $loop != true ]]; then
    rm -f "$file"
  elif [[ -n $at ]]; then
    # Times missed while the machine was off or asleep are skipped.
    due=$(next_after "$at" "$seconds" "$(date +%s)")
    save "$unit" "$due"
    start_timer "$unit" "$due" || true
  fi
  # Omarchy lets its own action toasts through "Silence notifications", and
  # that is what a notification without an app name counts as.
  if [[ $quiet == true ]]; then
    notify --app-name "$prefix" "Reminder" "$message"
  else
    notify "Reminder" "$message"
  fi
}

add() {
  local loop=false quiet=true seconds message label unit at length

  while [[ ${1:-} == "--loop" || ${1:-} == "--loud" ]]; do
    [[ $1 == "--loop" ]] && loop=true || quiet=false
    shift
  done

  seconds=$(to_seconds "${1:-}")
  shift || true
  message="$*"

  if [[ -z $seconds ]]; then
    usage
    exit 1
  fi
  length=$(spoken "$seconds")

  label=$message
  [[ -n $label ]] || label="Your $length are up"

  mkdir -p "$state_dir"
  unit="$prefix-$(date +%s)-$RANDOM"
  at=$(($(date +%s) + seconds))

  if ! start_timer "$unit" "$at"; then
    notify "Reminder not set" "The timer could not be started"
    exit 1
  fi

  # Written after the timer exists, so `list` never sees a file without one.
  jq -cn --argjson seconds "$seconds" --arg message "$message" --arg label "$label" --argjson loop "$loop" \
    --argjson quiet "$quiet" --argjson at "$at" \
    '{seconds:$seconds,message:$message,label:$label,loop:$loop,quiet:$quiet,at:$at}' >"$state_dir/$unit.json"

  at=$(date -d "@$at" +%-H:%M)
  if [[ $loop == true ]]; then
    notify "${message:-Reminder} every $length" "First at $at"
  elif [[ -n $message ]]; then
    notify "$message in $length" "You'll be reminded at $at"
  else
    notify "Reminder set for $length" "You'll be reminded at $at"
  fi
}

# A reminder set before timers were kept by clock time: one timer under the
# reminder's own name, counting down. Gives the time it is next due and stops
# that timer, so `list` can set one by the clock in its place.
adopt() {
  local unit=$1 seconds=$2 now=$3 timers at

  timers=$(systemctl --user list-timers --all --output=json "$unit.timer" 2>/dev/null || echo "[]")
  [[ -n $timers ]] || timers="[]"
  at=$(jq -r --arg t "$unit.timer" --argjson step "$seconds" \
    '[.[] | select(.unit == $t)][0] // {} | if .next then (.next / 1000000 | floor) elif .last then (.last / 1000000 | floor) + $step else 0 end' <<<"$timers")
  ((at > now)) || at=$((now + seconds))
  systemctl --user stop "$unit.timer" 2>/dev/null || true
  echo "$at"
}

# Prints the reminders as JSON, soonest first. A reminder whose timer is gone
# (a reboot, a logout) gets it back for the time it was due; a looping one
# that was missed meanwhile moves on to its next time, a one-off is forgotten.
list() {
  local now file unit seconds loop at item reminders="[]"

  now=$(date +%s)
  mkdir -p "$state_dir"

  for file in "$state_dir"/$prefix-*.json; do
    [[ -f $file ]] || continue
    unit=$(basename "$file" .json)
    valid_unit "$unit" || continue
    seconds=$(jq -r '.seconds' "$file" 2>/dev/null || echo "")
    loop=$(jq -r '.loop' "$file" 2>/dev/null || echo "")
    if [[ ! $seconds =~ ^[0-9]+$ ]]; then
      rm -f "$file"
      continue
    fi

    at=$(jq -r '.at // empty' "$file" 2>/dev/null || echo "")
    if [[ ! $at =~ ^[0-9]+$ ]]; then
      at=$(adopt "$unit" "$seconds" "$now")
      save "$unit" "$at"
    fi

    if ! timer_active "$unit" "$at"; then
      if ((at > now)); then
        start_timer "$unit" "$at" || continue
      elif ((now - at < 60)); then
        # Due just now: its timer is firing and will see to the file itself.
        [[ $loop == true ]] || continue
      elif [[ $loop == true ]]; then
        at=$(next_after "$at" "$seconds" "$now")
        save "$unit" "$at"
        start_timer "$unit" "$at" || continue
      else
        # A one-off that came due while the session was gone.
        rm -f "$file"
        continue
      fi
    fi

    item=$(jq -c --arg unit "$unit" --argjson at "$at" '. + {unit:$unit,at:$at}' "$file")
    reminders=$(jq -cn --argjson all "$reminders" --argjson item "$item" '$all + [$item]')
  done

  jq -cn --argjson reminders "$reminders" --argjson now "$now" \
    '{now:$now,reminders:($reminders | sort_by(.at))}'
}

stop() {
  local unit=${1:-}

  valid_unit "$unit" || { usage; exit 1; }
  rm -f "$state_dir/$unit.json"
  systemctl --user stop "$unit-*.timer" "$unit.timer" 2>/dev/null || true
}

clear() {
  local file unit count=0

  for file in "$state_dir"/$prefix-*.json; do
    [[ -f $file ]] || continue
    unit=$(basename "$file" .json)
    valid_unit "$unit" || continue
    stop "$unit"
    count=$((count + 1))
  done

  ((count > 0)) && notify "All reminders have been cleared"
  return 0
}

# One command at a time: the panel's service lists every minute, and two
# commands deciding about the same timer would each set their own.
case ${1:-} in
add | list | stop | clear | fire)
  mkdir -p "$state_dir"
  exec 9>"$state_dir/.lock"
  flock 9
  ;;
esac

case ${1:-} in
add)
  shift
  add "$@"
  ;;
list)
  list
  ;;
stop)
  stop "${2:-}"
  ;;
clear)
  clear
  ;;
fire)
  valid_unit "${2:-}" || exit 1
  [[ ${3:-} =~ ^[0-9]*$ ]] || exit 1
  fire "$2" "${3:-}"
  ;;
*)
  usage
  exit 1
  ;;
esac
